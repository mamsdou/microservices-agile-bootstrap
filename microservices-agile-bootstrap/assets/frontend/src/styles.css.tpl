body { font-family: system-ui, sans-serif; margin: 0; background: #f5f6f8; color: #1f2933; }
header { background: #1f3a5f; color: #fff; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
header h1 { margin: 0; font-size: 1.4rem; }
header .user { display: flex; gap: .8rem; align-items: center; }
header .user button { padding: .35rem .8rem; border: 0; border-radius: 4px; cursor: pointer; }
main { max-width: 52rem; margin: 2rem auto; padding: 0 1rem; }
nav button { margin-right: .5rem; padding: .4rem .9rem; border: 1px solid #1f3a5f; background: #fff; cursor: pointer; border-radius: 4px; }
nav button.active { background: #1f3a5f; color: #fff; }
form { margin: 1rem 0; display: flex; gap: .5rem; }
input { flex: 1; padding: .45rem; }
ul { list-style: none; padding: 0; }
li { background: #fff; margin-bottom: .4rem; padding: .6rem .9rem; border-radius: 4px; display: flex; justify-content: space-between; }
small { color: #6b7785; }
.error { color: #b00020; }
